# Public Supabase project configuration. Put real values in .env.local (never commit it).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Current server API persistence (local development)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=clusterbuy

# Server-only Gemini configuration for material suggestions.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional; defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
